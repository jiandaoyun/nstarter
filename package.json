{
  "name": "nstarter",
  "private": true,
  "workspaces": [
    "cli",
    "core",
    "packages/*",
    "tools/*",
    "development/*",
    "ci/toolbox/*"
  ],
  "scripts": {
    "build": "npx nx run-many -t build",
    "eslint": "npx nx run-many -t eslint",
    "eslint:html": "npx nx run-many -t eslint:html",
    "test": "npx nx run-many -t test",
    "pack": "mkdirp ./build && npm pack --workspaces --pack-destination ./build",
    "upload": "npx nx run-many -t upload",
    "clean": "npx nx run-many -t clean && rimraf .nx/cache && rimraf ./build",
    "reset": "npx nx reset",
    "test:request": "nx run nstarter-http-request:test",
    "build:request": "nx run nstarter-http-request:build"
  },
  "devDependencies": {
    "@types/chai": "^5.2.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.18.5",
    "@types/sinon": "^21.0.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "chai": "^6.0.1",
    "eslint": "^8.56.0",
    "eslint-config-nstarter": "^4.0.1",
    "mkdirp": "^3.0.1",
    "mocha": "^11.7.2",
    "nstarter-tsconfig": "*",
    "nx": "21.5.2",
    "nyc": "^17.1.0",
    "rimraf": "^6.0.1",
    "semver": "^7.7.2",
    "sinon": "^21.0.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=22.19.0",
    "npm": ">=10.9.3"
  },
  "volta": {
    "node": "22.19.0",
    "npm": "10.9.3"
  }
}
